package aspwash {

    package parts {
        part def ResponsableMaintenance;
        part def ResponsableProduction;
        part def OperateurUsager;
        part def RobotNettoyage;
        part def ChariotElevateur;
        part def ZoneANettoyer;
        part def SolEtDechet;
        part def ReseauAlerteSite;
    }

    private import aspwash::parts::*;

    part def Contexte {
        part robot: RobotNettoyage;
        part responsableMaintenance: ResponsableMaintenance;
        part responsableProduction: ResponsableProduction;
        part operateursUsagers: OperateurUsager[*];
        part chariotsElevateurs: ChariotElevateur[*];
        part zoneANettoyer: ZoneANettoyer;
        part solEtDechet: SolEtDechet;
        part reseauAlerte: ReseauAlerteSite;

        flow supervise from responsableMaintenance to robot;
        flow pilote from responsableProduction to robot;
        flow croise from operateursUsagers to robot;
        flow croise from chariotsElevateurs to robot;
        flow nettoie from robot to zoneANettoyer;
        flow traite from robot to solEtDechet;
        flow alerte from robot to reseauAlerte;
    }

    package useCases {
        private import aspwash::parts::*;

        actor responsableProduction: ResponsableProduction;
        actor operateursUsagers: OperateurUsager;
        actor responsableMaintenance: ResponsableMaintenance;
        actor reseauAlerte: ReseauAlerteSite;

        use case choisirModeNettoyage;
        use case signalerDechetInhabituel;
        use case ralentirContournerArreter;
        use case deployerRecupererSatellite;
        use case localiserIncident;

        use case reconnaitreDechets {
            subject robot: RobotNettoyage;
            actor responsableProduction;
            actor operateursUsagers;
            actor responsableMaintenance;
        }

        use case detecterObstaclesUsagers {
            subject robot: RobotNettoyage;
            actor responsableProduction;
            actor operateursUsagers;
            actor responsableMaintenance;
        }

        use case nettoyerZoneInaccessible {
            subject robot: RobotNettoyage;
            actor responsableProduction;
            actor operateursUsagers;
            actor responsableMaintenance;
        }

        use case alarmeInterventionSol {
            subject robot: RobotNettoyage;
            actor reseauAlerte;
        }
    }

    package exigences {
        private import aspwash::parts::*;

        enum def Priorite {
            enum haute;
            enum moyenne;
        }

        requirement def ExigenceRobot {
            subject robot: RobotNettoyage;
            attribute priorite: Priorite;
        }

        requirement reconnaissanceDechets {
            requirement <'F1.1'> reconnaitreSaletes: ExigenceRobot {
                doc /* Le robot reconnait les types de saletes : graisse, huile, eau, papier. */
                attribute :>> priorite = Priorite::haute;
            }
            requirement <'F1.2'> classerSaletes: ExigenceRobot {
                doc /* Il classe correctement les saletes rencontrees. */
                attribute :>> priorite = Priorite::haute;
            }
            requirement <'F1.3'> choisirModeNettoyage: ExigenceRobot {
                doc /* Il choisit un mode de nettoyage adapte a la salete reconnue. */
                attribute :>> priorite = Priorite::haute;
            }
            requirement <'F1.4'> signalerDechetInconnu: ExigenceRobot {
                doc /* Il signale un dechet inconnu ou trop important et le place sur la carte. */
                attribute :>> priorite = Priorite::moyenne;
            }
            requirement <'F1.5'> identifierAvantTraiter: ExigenceRobot {
                doc /* Il identifie la salete avant de la traiter. */
                attribute :>> priorite = Priorite::moyenne;
            }
        }

        requirement detectionObstacles {
            requirement <'F2.1'> detecterPersonne: ExigenceRobot {
                doc /* Le robot detecte toute personne sur sa trajectoire. */
                attribute :>> priorite = Priorite::haute;
            }
            requirement <'F2.2'> distinguerObstacles: ExigenceRobot {
                doc /* Il distingue personne, chariot ou AGV, machine et objet. */
                attribute :>> priorite = Priorite::haute;
            }
            requirement <'F2.3'> ralentirPuisArreter: ExigenceRobot {
                doc /* Il ralentit puis s'arrete avant tout contact. */
                attribute :>> priorite = Priorite::haute;
            }
            requirement <'F2.4'> contournerObstacle: ExigenceRobot {
                doc /* Il contourne l'obstacle ou recalcule son itineraire si le passage est bloque. */
                attribute :>> priorite = Priorite::moyenne;
            }
            requirement <'F2.5'> arretUrgence: ExigenceRobot {
                doc /* Un arret d'urgence est possible sur le robot et a distance. */
                attribute :>> priorite = Priorite::haute;
            }
        }

        requirement alarmeIntervention {
            requirement <'F3.1'> detecterEtLocaliser: ExigenceRobot {
                doc /* Le systeme detecte un deversement, un dechet inhabituel ou un danger et le localise sur la carte. */
                attribute :>> priorite = Priorite::haute;
            }
            requirement <'F3.2'> alarmeSonoreLumineuse: ExigenceRobot {
                doc /* Il declenche une alarme sonore et lumineuse sur place. */
                attribute :>> priorite = Priorite::haute;
            }
            requirement <'F3.3'> envoyerAlerte: ExigenceRobot {
                doc /* Il envoie l'alerte et la position au reseau d'alerte du site. */
                attribute :>> priorite = Priorite::haute;
            }
            requirement <'F3.4'> envoyerIntervention: ExigenceRobot {
                doc /* Il envoie une intervention rapide aux points d'intervention definis (zones a risque). */
                attribute :>> priorite = Priorite::haute;
            }
            requirement <'F3.5'> enregistrerAlerte: ExigenceRobot {
                doc /* Il enregistre chaque alerte (heure, lieu, type) dans le rapport. */
                attribute :>> priorite = Priorite::moyenne;
            }
        }

        requirement robotSatellite {
            requirement <'F4.1'> deployerEtRevenir: ExigenceRobot {
                doc /* Le satellite est embarque sur le robot principal, se deploie et revient seul. */
                attribute :>> priorite = Priorite::haute;
            }
            requirement <'F4.2'> accederSousMachines: ExigenceRobot {
                doc /* Il accede aux zones sous les machines. */
                attribute :>> priorite = Priorite::haute;
            }
            requirement <'F4.3'> resterEnLiaison: ExigenceRobot {
                doc /* Il reste en liaison avec le robot principal. */
                attribute :>> priorite = Priorite::haute;
            }
            requirement <'F4.4'> nettoyerEtRemettreDechets: ExigenceRobot {
                doc /* Il nettoie la zone et remet les dechets au robot principal. */
                attribute :>> priorite = Priorite::haute;
            }
            requirement <'F4.5'> machineALArret: ExigenceRobot {
                doc /* Il ne passe sous une machine que si elle est a l'arret. */
                attribute :>> priorite = Priorite::haute;
            }
        }
    }
}

